# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=8787
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=4000        # ceiling the browser cannot exceed
RATE_LIMIT_PER_MIN=20         # per IP
ACCESS_CODE=                  # if set, browser must send header x-access-code
